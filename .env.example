# Copie para .env e preencha. NUNCA faça commit do .env.

# Password única do backoffice (mínimo 8 caracteres)
ADMIN_PASSWORD=mude-esta-password

# Segredo para assinar as sessões — gere com: openssl rand -hex 32
SESSION_SECRET=

# Valores iniciais (depois editáveis no backoffice → Configuração)
ORGANIZATION=Associação de Pais do Centro Social da Imaculada Conceição
EVENT_NAME=Rifa de Natal
EVENT_INFO=
DRAW_DATE=2026-12-07
TOTAL_TICKETS=250
# Preço por rifa em euros (0 = não mostrar valores)
TICKET_PRICE=2

# Servidor
PORT=3000
SESSION_HOURS=12
# auto = cookie "Secure" quando o pedido chega por HTTPS (recomendado atrás de um proxy)
COOKIE_SECURE=auto
# DB_PATH=./data/rifas.db
